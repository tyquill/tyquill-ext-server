# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/tyquill_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tyquill_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Chrome Extension
CHROME_EXTENSION_ID=your-chrome-extension-id

# JWT Authentication
JWT_SECRET=your-jwt-secret-key

# Google Vertex AI Configuration
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type": "service_account", ...}
GOOGLE_VERTEX_PROJECT_ID=your-project-id
GOOGLE_VERTEX_LOCATION=us-central1

# Langfuse Observability (OpenTelemetry)
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# or for US region: https://us.cloud.langfuse.com

# LangChain Tracing (Optional - you can use Langfuse instead)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_PROJECT=your-project-name

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_USERNAME=default

# AWS S3 Storage
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=your-bucket-name
AWS_REGION=ap-northeast-2

# Cloudflare R2 Storage (Alternative to S3)
STORAGE_BUCKET=your-bucket-name
STORAGE_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
STORAGE_ACCESS_KEY_ID=your-r2-access-key
STORAGE_SECRET_ACCESS_KEY=your-r2-secret-key
STORAGE_REGION=auto
STORAGE_PUBLIC_URL=https://your-public-url.r2.dev

# PostHog Analytics
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://us.i.posthog.com

# Tyquill Agent API
TYQUILL_AGENT_API_URL=http://localhost:8001

# AI Callback Secret
AI_CALLBACK_SECRET=your-ai-callback-secret

# Slack Bot (Optional)
SLACK_BOT_API_KEY=your-slack-bot-api-key
SLACK_BOT_SERVICE_ACCOUNT_ID=1

# Application Settings
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug
